MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=proctor_exam_system
JWT_SECRET=replace-with-a-long-random-secret

# Set both values to create or update the admin in the MongoDB users collection.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-secret-at-least-12-characters

# Optional: configure the same Google OAuth web client ID in frontend/.env.local.
GOOGLE_CLIENT_ID=

# Optional: add deployed frontend origins, comma-separated.
FRONTEND_URL=

# Optional: backend port (defaults to 5000).
PORT=5000